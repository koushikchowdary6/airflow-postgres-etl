# Copy to .env and edit. .env is gitignored.
#
#   cp .env.example .env
#   # then, to use these values in your own shell:
#   set -a && . ./.env && set +a
#
# docker compose reads .env automatically.

# ---- Passwords (change these; the values below are placeholders) ------------
# Pipeline role, owns the warehouse databases.
POSTGRES_PASSWORD=change-me-etl
# PostgreSQL superuser, used only to create roles and databases on first start.
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
# Airflow's own metadata database role.
AIRFLOW_DB_PASSWORD=change-me-airflow
# Airflow web UI admin login.
AIRFLOW_ADMIN_PASSWORD=change-me-admin

# ---- Warehouse connection ---------------------------------------------------
# Use "localhost" from your shell and the test suite; the Airflow containers
# override this to "postgres" (the service name) in docker-compose.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=congress_etl
POSTGRES_USER=etl

# ---- Pipeline behaviour (optional; defaults shown) --------------------------
# Congresses below the watermark to re-read each run, so a late upstream
# correction is picked up. Safe because the upsert is keyed on the natural key.
# ETL_LOOKBACK_CONGRESSES=1

# Set false to log data-quality failures as warnings instead of failing the run.
# ETL_FAIL_ON_QUALITY_ERROR=true

# ETL_DATA_DIR=./data
# ETL_STATEMENT_TIMEOUT_MS=120000
# LOG_LEVEL=INFO

# ---- Airflow (optional) -----------------------------------------------------
# AIRFLOW_PORT=8080
# AIRFLOW_ADMIN_USER=admin
# AIRFLOW_ADMIN_EMAIL=admin@example.com
